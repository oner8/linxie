LINXIE_IMAGE=linxie:0.1.3
LINXIE_PORT=3100
LINXIE_FONT_DIR=./data/fonts
LINXIE_CACHE_DIR=./data/cache
# 可选：B 站登录后的 SESSDATA，用于提高示范视频画质（不填则最高 480p）。
# 也可用 LINXIE_VIDEO_DATA 指定示范视频数据路径。
# 留空则视频经本服务代理 B 站；填上预切片服务器地址则直接从该地址取（勿以斜杠结尾）。
# LINXIE_CLIPS_BASE=https://clips.example.com/linxie
# BILIBILI_SESSDATA=
